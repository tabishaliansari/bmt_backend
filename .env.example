# Copy to .env and fill in. Never commit .env.

# --- AI (Gemini) ---
# Local mode: API key from AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Current Flash and Pro model IDs as shown in AI Studio / Vertex AI
GEMINI_FAST_MODEL=
GEMINI_PRO_MODEL=
# Cloud mode: true = Gemini on Vertex AI (uses GCP_PROJECT + VERTEX_LOCATION, no API key)
USE_VERTEX=false
GCP_PROJECT=
VERTEX_LOCATION=us-central1

# --- Storage and database ---
# local | gcs
STORAGE=local
GCS_BUCKET=
# sqlite | firestore
DB=sqlite

# --- Uploads and money ---
MAX_UPLOAD_MB=50
PLATFORM_FEE_PCT=15
# Fixed demo FX rate (labelled as such in the UI)
DEMO_FX_USD_INR=84.10
