# Copy to .env and fill in. Never commit .env.

# --- AI ---
# Local mode: API key from AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Model IDs as shown in AI Studio / Vertex AI
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.8-flash
# Gemma screens notes and feedback (empty = no screening)
GEMINI_SCREEN_MODEL=gemma-4-26b-a4b-it
# Nano Banana drafts thumbnails (empty = feature off; needs a billed project or Vertex)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Cloud mode: true = Gemini on Vertex AI (uses GCP_PROJECT + VERTEX_LOCATION, no API key)
USE_VERTEX=false
GCP_PROJECT=
VERTEX_LOCATION=us-central1
# Seconds before a Gemini call gives up
AI_TIMEOUT_SEC=90
# Clips up to this size go to Gemini inline; larger ones use the Files API (local mode)
INLINE_VIDEO_MAX_MB=15
# Gemini calls per signed-in user per hour
AI_RATE_LIMIT_PER_HOUR=30

# --- Storage and database ---
# local | gcs
STORAGE=local
GCS_BUCKET=
# sqlite | firestore
DB=firestore
# Local Firestore emulator (started by scripts/dev.sh). Leave empty on Cloud Run.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081

# --- Auth: Firebase Authentication with Google sign-in ---
# firebase | off (off = everyone is one local user; local development only)
AUTH=firebase
# Web API key from the Firebase console (any value works with the emulator)
FIREBASE_API_KEY=
# Defaults to <GCP_PROJECT>.firebaseapp.com
FIREBASE_AUTH_DOMAIN=
# Local Auth emulator (started by scripts/dev.sh). Leave empty on Cloud Run.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Uploads, money, media links ---
# Cloud Run caps requests at 32 MB, so keep this under 32 when deployed
MAX_UPLOAD_MB=50
PLATFORM_FEE_PCT=15
# Fixed demo FX rate (labelled as such in the UI)
DEMO_FX_USD_INR=84.10
# Secret for signed media links. Set a long random value on Cloud Run (Secret Manager);
# if empty, a random one is made per process and links break across instances.
MEDIA_SIGNING_KEY=
